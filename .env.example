# Copy this file to .env for Docker Compose. Values below are for local use only.

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=arc_stream
DB_EXPOSE_PORT=5432

# Groq Cloud API (optional; prompt planning has a local heuristic fallback)
# Get an API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Spotify Developer API (Required for Spotify Login & Playback)
# Create an app at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
FRONTEND_URL=http://127.0.0.1:5173
VITE_NODE_BASE=http://127.0.0.1:3000

# Local Docker Compose behavior
NODE_ENV=development
KEEP_ALIVE_INTERVAL_HOURS=48
